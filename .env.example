# Tinderbox env file. Copy to ~/.tinderbox.env (or wherever you prefer)
# and point TINDERBOX_ENV_FILE at it. The parser reads this on startup.
#
# Default lookup: $TINDERBOX_ENV_FILE, falling back to ~/.secrets/shared.env
# (the author's convention).

# --- Supabase --------------------------------------------------------------
# Create a free project at https://supabase.com — Settings → API for these
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: direct DB connection for the tinderbox_owner role (stage 5b).
# Requires the IPv4 add-on if your network lacks IPv6 outbound.
# TINDERBOX_DB_URL=postgresql://tinderbox_owner:YOUR-PW@db.YOUR-REF.supabase.co:5432/postgres?sslmode=require

# --- Embedding model -------------------------------------------------------
TINDERBOX_EMBEDDING_MODEL=mxbai-embed-large
TINDERBOX_EMBEDDING_DIM=1024
# Optional provenance — capture once after `ollama pull` and lock it
TINDERBOX_EMBEDDING_MANIFEST_DIGEST=
TINDERBOX_EMBEDDING_BLOB_SHA256=

# --- Filesystem roots ------------------------------------------------------
# Defaults assume ~/tinderbox/. Override if you want them elsewhere.
# TINDERBOX_INBOX=/path/to/inbox
# TINDERBOX_WORK=/path/to/work
# TINDERBOX_ARCHIVE=/path/to/archive
# TINDERBOX_LOGS=/path/to/logs
# TINDERBOX_BLOB_ROOT=/path/to/blobs

# --- Ollama ----------------------------------------------------------------
TINDERBOX_OLLAMA_URL=http://localhost:11434

# --- Parser knobs ----------------------------------------------------------
TINDERBOX_STABLE_SECONDS=30      # Inbox watcher: file size must hold steady this long
TINDERBOX_ORPHAN_MINUTES=30      # Mark stuck `running` ingest_runs as failed after this
TINDERBOX_CANARY_PCT=10          # Mass-tombstone halt threshold (% of active conversations)
TINDERBOX_CANARY_ABS=50          # OR absolute count, whichever is smaller

# --- Anthropic API (for QA query generation via Haiku) --------------------
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-KEY

# --- Logging ---------------------------------------------------------------
TINDERBOX_LOG_LEVEL=INFO
